{
  "name": "grocer-data-completion-translation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.ts",
    "translate:google": "node --env-file=.env src/index.ts --provider google",
    "translate:baidu": "node --env-file=.env src/index.ts --provider baidu",
    "translate:baidu-llm": "node --env-file=.env src/index.ts --provider baidu-llm",
    "translate:deepl": "node --env-file=.env src/index.ts --provider deepl",
    "retry:failed": "node --env-file=.env src/index.ts --provider deepl --retry-failed",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test package.json tsconfig.json README.md",
    "format:check": "prettier --check src test package.json tsconfig.json README.md",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.1.0",
    "dom-serializer": "^3.1.1",
    "htmlparser2": "^12.0.0",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  }
}
