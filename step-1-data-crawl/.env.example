# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017

# Optional full-sync target. When omitted, the default is grocer_data_YYYY-MM-DD.
# GROCER_FULL_SYNC_DATABASE=grocer_data_custom

# Optional Grocer source override
GROCER_DB_URL=https://assets-prod.grocer.nz/public/base_v3.duckdb.br

# Full MongoDB synchronization
MONGO_BATCH_SIZE=100
MONGO_BATCH_DELAY_MS=250
GROCER_SKIP_DOWNLOAD=false

# Incremental MongoDB synchronization
GROCER_INCREMENTAL_BATCH_SIZE=500

# Pending MongoDB changes to Supabase
GROCER_SUPABASE_SYNC_BATCH_SIZE=100
GROCER_SUPABASE_SYNC_DELAY_MS=1000

# Supabase REST migration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-side-secret-key
GROCER_MIGRATION_BATCH_SIZE=100
GROCER_MIGRATION_DELAY_MS=1000

# Administrative SQL only; not read by the TypeScript scripts
SUPABASE_DB_URL=postgresql://postgres:password@host:5432/postgres
