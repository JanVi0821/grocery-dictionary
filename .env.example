# 可选：统一服务端配置。系统环境变量 > 本文件 > runtime/<业务>/.env。
# 不复制到前端，不提交真实凭证。凭证文件推荐使用绝对路径。
MONGODB_URI=mongodb://127.0.0.1:27017/grocery_dictionary
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-secret
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres
REDIS_URL=redis://127.0.0.1:6379
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json
# DeepL 使用 runtime/translation/deep-api-keys.ts，不使用 env API key。
